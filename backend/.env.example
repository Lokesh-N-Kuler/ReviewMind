# ReviewMind Backend Environment Configuration

# Database: PostgreSQL connection string or SQLite for local dev
# Example PostgreSQL: postgresql+psycopg2://postgres:postgres@localhost:5432/reviewmind
# Example SQLite: sqlite:///./reviewmind.db
DATABASE_URL=sqlite:///./reviewmind.db

# Authentication Security
JWT_SECRET_KEY=change-this-to-a-secure-random-secret-key-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Configuration (Groq)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_SECONDS=60

# Persistent Memory (Hindsight by Vectorize)
# Connect to Hindsight Cloud (https://api.hindsight.vectorize.io) or self-hosted server
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
HINDSIGHT_BANK_ID=reviewmind
HINDSIGHT_API_KEY=your_hindsight_cloud_api_key_here
HINDSIGHT_TIMEOUT_SECONDS=60

# GitHub Integration (OAuth App or Personal Access Token)
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret
GITHUB_REDIRECT_URI=http://localhost:3000/github/callback

# Frontend URL for CORS
FRONTEND_URL=http://localhost:3000
